PORT=3000
MYSQL_HOST=localhost
MYSQL_PORT=3307
PHPMYADMIN_PORT=8081
MYSQL_USER=judici_app
MYSQL_PASSWORD=change-me
MYSQL_REGISTRY_DATABASE=judicia_registry
MARIADB_ROOT_PASSWORD=local-root-change-this
JEVMODEL_BASE_URL=http://127.0.0.1:8000/v1/systemone
JEVMODEL_NAME=multilingual
TRIAGE_AUTOMATION_APPROVED=false
# Configure uma chave longa para proteger salvamento e prévias da triagem.
TRIAGE_SETTINGS_KEY=
# Use true behind HTTPS in the production environment.
SESSION_COOKIE_SECURE=false
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
TICKETING_PROVIDER=mock
# GLPI 11 API v2. Keep empty while using the mock connector.
# Base URL is the API root published by your instance, commonly https://glpi.example.org/api.php
GLPI_API_BASE_URL=
GLPI_CLIENT_ID=
GLPI_CLIENT_SECRET=
GLPI_USERNAME=
GLPI_PASSWORD=
GLPI_API_SCOPE=api
GLPI_API_VERSION=v2
GLPI_KNOWLEDGE_RESOURCE=Knowledgebase/Article
GLPI_QUEUE_CATEGORY_IDS=

# Chave Base64 de 32 bytes para criptografar credenciais de integracao por tenant
TENANT_SECRETS_KEY=

# Provedor da LLM Conversacional do Copilot (Configurado no Servidor Central)
# Provedores: openai_compatible, openai, openrouter, groq, ollama, hermes (ou rules para desligar a LLM).
# Hermes no próprio servidor: COPILOT_LLM_PROVIDER=ollama, COPILOT_LLM_BASE_URL=http://localhost:11434/v1, COPILOT_LLM_MODEL=hermes3
COPILOT_LLM_PROVIDER=openai_compatible
COPILOT_LLM_BASE_URL=https://openrouter.ai/api/v1
COPILOT_LLM_API_KEY=sua-chave-aqui
COPILOT_LLM_MODEL=nousresearch/hermes-3-llama-3.1-8b

# Fallback local determinístico se nenhuma chave for configurada
COPILOT_FALLBACK_RULES=true

# Opcionais: formato das chamadas de ferramenta (auto | native | hermes) e tempo limite da LLM.
# COPILOT_LLM_TOOL_MODE=auto
# COPILOT_LLM_TIMEOUT_MS=45000
# Atrás de proxy reverso, use o X-Forwarded-For para identificar a estação pelo IP.
# COPILOT_TRUST_PROXY=false

# PostgreSQL de origem, usado somente pelo comando db:migrate:postgres
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=change-me
PGDATABASE=judicia_a

# Monitoramento preventivo (opcional; somente backend). Zabbix 7.x com API token.
ZABBIX_API_URL=
ZABBIX_API_TOKEN=
# Mapeamento JSON mantido pelo administrador da implantação, nunca pelo navegador:
# {"<tenant-uuid>":{"ESTACAO-1":{"availability":{"id":"1001","healthyValue":1},"latency":{"id":"1002","threshold":150},"loss":{"id":"1003","threshold":5}}}}
ZABBIX_TENANT_ITEMS={}

# Endpoint compatível com /embeddings. Sem configuração: lexical + metadados.
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=
EMBEDDING_API_KEY=

# Agenda sintética automática no backend (sempre identificada DEMO)
DEMO_MODE=false
